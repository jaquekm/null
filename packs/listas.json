{
  "key": "listas",
  "version": "1.0.0",
  "name": "Listas",
  "description": "Checklists reutilizáveis — compras, viagem, mudança de casa, checklist de processo — com modo lista otimizado pro celular.",
  "icon": "✅",
  "requires": [],
  "types": [
    {
      "ref": "list",
      "name": "Lista",
      "plural": "Listas",
      "slug": "lista",
      "icon": "✅",
      "defaultView": "list",
      "fields": [
        {
          "key": "list_kind",
          "label": "Tipo de lista",
          "type": "select",
          "showInCard": true,
          "options": [
            { "id": "compras", "label": "Compras" },
            { "id": "viagem", "label": "Viagem" },
            { "id": "mudanca_de_casa", "label": "Mudança de casa" },
            { "id": "checklist_de_processo", "label": "Checklist de processo" },
            { "id": "outros", "label": "Outros" }
          ]
        },
        { "key": "recurring", "label": "Recorrente", "type": "checkbox", "showInCard": true },
        { "key": "shared_with", "label": "Compartilhada com", "type": "contact", "multiple": false }
      ]
    }
  ],
  "views": [
    {
      "ref": "listas_lista",
      "typeRef": "list",
      "name": "Listas",
      "kind": "list",
      "isDefault": true,
      "config": { "filters": [], "sort": [{ "field": "title", "dir": "asc" }], "visibleFields": ["list_kind", "recurring"] }
    }
  ],
  "automations": [],
  "reminderRules": [],
  "sampleItems": [
